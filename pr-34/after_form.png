:root {
  --cursor-bg-accent: var(--bg-accent);
  --cursor-bg-accent-hover: var(--bg-accent-hover);
  --cursor-accent: var(--accent);
  --cursor-base: var(--base);
  --cursor-blue: var(--blue);
  --cursor-purple: var(--purple);
  --cursor-added: var(--added);
  --cursor-modified: var(--modified);
  --cursor-removed: var(--removed);
  --cursor-untracked: var(--untracked);
  --cursor-success: var(--success);
  --cursor-warn: var(--warn);
  --cursor-danger: var(--danger);
  --cursor-focus: var(--focus);
  --cursor-chrome: var(--chrome);
  --cursor-editor: var(--editor);
  --cursor-action-label: var(--actionLabel);
  --cursor-stroke-git-added: var(--border-added-secondary);
  --cursor-stroke-git-removed: var(--border-removed-secondary);
  /* Font weights are not on ThemeDefinition, so generateTokenCSS
   * never emits them. @anysphere/ui and cursor-review both read
   * --cursor-font-weight-*; point at portal --font-weight-* so brands
   * resolve at the value layer. "regular" is an alias — portal has no
   * regular name. */
  --cursor-font-weight-normal: var(--font-weight-normal);
  --cursor-font-weight-regular: var(--font-weight-normal);
  --cursor-font-weight-medium: var(--font-weight-medium);
  --cursor-font-weight-semibold: var(--font-weight-semibold);
  --cursor-font-weight-bold: var(--font-weight-bold);
}
